# 本地开发示例：复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不提交）
# HOST 默认 0.0.0.0（全网段），局域网经 http://192.168.0.101:PORT 访问；
# 设为 127.0.0.1 则仅本机，设为 192.168.0.101 则仅该网卡。
HOST=0.0.0.0
PORT=3000
# 前端构建产物（npm run build 生成 frontend/dist），缺失时 API 照常可用
WEB_DIR=frontend/dist
# PostgreSQL / Redis：懒连接，无库也可启动；有库时执行 sqlx migrate run
DATABASE_URL=postgres://cngokz:cngokz@127.0.0.1:5432/cngokz
REDIS_URL=redis://127.0.0.1:6379
RUST_LOG=cngokz_backend=info,tower_http=info
# 前端 dev 代理目标（局域网联调后端时改 IP）
# VITE_API_PROXY=http://192.168.0.101:3000
